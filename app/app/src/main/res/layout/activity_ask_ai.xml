<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:paddingStart="11dp" android:paddingEnd="13dp"
        android:paddingTop="12dp" android:paddingBottom="12dp">
        <ImageView android:id="@+id/iv_back" android:layout_width="47dp" android:layout_height="36dp"
            android:src="@mipmap/icon_back" android:scaleType="fitXY" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/tv_title" style="@style/TitleText" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="问 AI" android:layout_marginStart="31dp"
            android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/divider"/>

    <WebView android:id="@+id/web_chat"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:padding="12dp"/>

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="10dp" android:gravity="center_vertical">
        <EditText android:id="@+id/et_input" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:background="@drawable/shape_input" android:hint="输入你的问题…（长按说话，上滑取消）" android:textColorHint="@color/gray"
            android:textColor="@color/white" android:textSize="21sp" android:paddingHorizontal="14dp"
            android:maxLines="1" android:inputType="text" android:imeOptions="actionSend"/>
        <TextView android:id="@+id/tv_send" android:layout_width="72dp" android:layout_height="36dp"
            android:background="@drawable/shape_blue_btn" android:gravity="center" android:layout_marginStart="10dp"
            android:text="发送" android:textColor="@color/white" android:textSize="21sp"/>
    </LinearLayout>
</LinearLayout>
