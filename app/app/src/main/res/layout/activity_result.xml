<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">

    <LinearLayout android:id="@+id/ll_title" android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:paddingStart="11dp" android:paddingEnd="13dp"
        android:paddingTop="12dp" android:paddingBottom="12dp">
        <ImageView android:id="@+id/iv_back" android:layout_width="47dp" android:layout_height="36dp"
            android:src="@mipmap/icon_back" android:scaleType="fitXY" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/tv_title" style="@style/TitleText" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="题目详情" android:layout_marginStart="31dp"
            android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/tv_book" style="@style/Pill"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:singleLine="true" android:drawablePadding="4dp"
            android:text="错题本" android:drawableStart="@mipmap/icon_tjiao"/>
        <TextView android:id="@+id/tv_fav" style="@style/Pill"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:singleLine="true" android:layout_marginStart="10dp" android:drawablePadding="4dp"
            android:text="收藏" android:drawableStart="@drawable/ic_star_line"/>
    </LinearLayout>

    <View android:id="@+id/divider" android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_below="@id/ll_title" android:background="@drawable/divider"/>

    <LinearLayout android:id="@+id/ll_tabs" android:orientation="horizontal"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_below="@id/divider" android:layout_marginStart="15dp" android:layout_marginTop="8dp">
        <TextView android:id="@+id/tab_stem" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="题干" android:textSize="21sp" android:paddingHorizontal="16dp" android:paddingVertical="4dp"/>
        <TextView android:id="@+id/tab_answer" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="解答" android:textSize="21sp" android:paddingHorizontal="16dp" android:paddingVertical="4dp"
            android:layout_marginStart="10dp"/>
    </LinearLayout>

    <WebView android:id="@+id/web_content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_below="@id/ll_tabs" android:layout_above="@+id/bottom_bar"
        android:layout_margin="15dp" android:background="@drawable/shape_card" android:padding="14dp"/>

    <LinearLayout android:id="@+id/bottom_bar" android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" android:gravity="end|center_vertical"
        android:padding="10dp">
        <ProgressBar android:id="@+id/pb" android:layout_width="24dp" android:layout_height="24dp"
            android:layout_marginEnd="16dp" android:visibility="gone"/>
        <TextView android:id="@+id/tv_ask" android:layout_width="96dp" android:layout_height="36dp"
            android:background="@drawable/shape_blue_btn" android:gravity="center"
            android:text="问 AI" android:textColor="@color/white" android:textSize="21sp"/>
    </LinearLayout>
</RelativeLayout>
