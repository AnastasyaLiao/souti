<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:paddingStart="11dp" android:paddingEnd="13dp">

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:paddingTop="12dp" android:paddingBottom="12dp">
        <TextView style="@style/TitleText" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="智能答疑" android:layout_marginStart="20dp"/>
        <TextView android:id="@+id/tv_account" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="end" android:textColor="@color/gray" android:textSize="19sp"
            android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/divider"/>

    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="10dp" android:layout_marginBottom="8dp"
        android:background="@drawable/shape_card" android:padding="16dp" android:gravity="center_vertical">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="用你的 fchat 账号登录一次，以后不用再登。" android:textColor="@color/white" android:textSize="21sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="识别与讲解走服务器，只有站主授权的账号能用。"
            android:textColor="@color/gray" android:textSize="18sp"/>

        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:gravity="center_vertical">
            <EditText android:id="@+id/et_user" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:background="@drawable/shape_input" android:hint="账号" android:textColorHint="@color/gray"
                android:textColor="@color/white" android:textSize="21sp" android:paddingHorizontal="14dp"
                android:maxLines="1" android:inputType="text" android:autofillHints="username"/>
            <EditText android:id="@+id/et_pass" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:layout_marginStart="10dp" android:background="@drawable/shape_input" android:hint="口令"
                android:textColorHint="@color/gray" android:textColor="@color/white" android:textSize="21sp"
                android:paddingHorizontal="14dp" android:maxLines="1" android:inputType="textPassword"
                android:autofillHints="password"/>
            <TextView android:id="@+id/tv_login" android:layout_width="86dp" android:layout_height="40dp"
                android:background="@drawable/shape_blue_btn" android:gravity="center" android:layout_marginStart="10dp"
                android:text="登录" android:textColor="@color/white" android:textSize="21sp"/>
        </LinearLayout>

        <TextView android:id="@+id/tv_err" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:textColor="@color/amber" android:textSize="19sp"
            android:maxLines="3" android:ellipsize="end" android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
