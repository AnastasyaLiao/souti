<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- 长按输入框语音提问：录音后交给局域网里的 FunASR 转文字 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <!-- 本机 HAL 只允许一路摄像头：进拍照页时用它端掉占着摄像头的后台进程（normal 权限，装完即生效） -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- 桌面入口是无障碍服务，别人（nu.nav.bar）一开机就把 enabled_accessibility_services 整条覆盖掉，
         顶替就哑了。声明这两条是为了开机自愈：WRITE_SECURE_SETTINGS 不申请也不会给，
         装完后用 adb pm grant 授权一次，之后每次开机自己把服务写回去。 -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <application
        android:label="智能答疑"
        android:theme="@style/Theme.Souti"
        android:icon="@android:drawable/sym_def_app_icon"
        android:allowBackup="false">

        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".PhotoActivity" android:screenOrientation="sensorLandscape"/>
        <activity android:name=".ResultActivity" android:screenOrientation="sensorLandscape"/>
        <activity android:name=".WrongBookActivity" android:screenOrientation="sensorLandscape"/>
        <activity android:name=".AskAIActivity" android:screenOrientation="sensorLandscape"/>

        <!-- 桌面「智能答疑」磁贴的目标组件写死在启动器 APK 里（无 root 改不动 /system），
             所以用这个无障碍服务做顶替：磁贴唤(orig)起原程序的一瞬间，把我们的主页面顶上去。
             adb 一条命令即可开启：settings put secure enabled_accessibility_services ... -->
        <service android:name=".LauncherTakeoverService"
            android:label="智能答疑桌面入口"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_takeover"/>
        </service>

        <!-- 开机 / 覆盖安装后把无障碍入口写回 secure 设置（详见 TakeoverHealer） -->
        <receiver android:name=".TakeoverHealer" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
